; Ufacity V2 — ART SOURCE project (NOT shipped). Holds GLB heroes and the sprite renderer.
; Run from the repo root with tools/render_hero.sh. The game project (../project.godot) never imports GLB.
config_version=5

[application]

config/name="Ufacity Art Source"

[display]

window/size/viewport_width=512
window/size/viewport_height=512

[rendering]

renderer/rendering_method="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
